# ─────────────────────────────────────────────────────────────
# Vow — environment config
# Copy to `.env` (or `.env.local`) and edit. Every value is optional:
# the app runs with sensible defaults when this file is absent.
# Only variables prefixed with VITE_ are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# Backend base URL. Leave empty to use the built-in mock APIs
# (leaderboard). When set, the app calls `${VITE_API_BASE_URL}/leaderboard`.
VITE_API_BASE_URL=

# Simulated network latency for mock APIs, in milliseconds.
VITE_MOCK_LATENCY_MS=450

# Stripe Payment Links per plan. Leave empty to use the demo checkout,
# which unlocks Pro locally after a confirmation dialog (no payment taken).
VITE_STRIPE_LINK_MONTHLY=
VITE_STRIPE_LINK_YEARLY=
VITE_STRIPE_LINK_LIFETIME=

# Hour (0–23, local time) the Evening Review unlocks. Set to 0 for demos.
VITE_EVENING_HOUR=20

# Hour (0–23) of the daily pledge reminder notification.
VITE_REMINDER_HOUR=9

# Show the Settings ▸ Developer tools (seed demo data, toggle Pro…).
# Always on in `npm run dev`; set to true to also show them in builds.
VITE_ENABLE_DEMO_TOOLS=false

# Links shown in Settings ▸ About and the invite feature.
VITE_PRIVACY_URL=https://example.com/privacy
VITE_SUPPORT_EMAIL=hello@vow.app
VITE_INVITE_BASE_URL=https://vow.app/invite
